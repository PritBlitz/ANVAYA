# Anvaya API — example configuration. Copy to `.env` for local development.
# Every value here is a safe placeholder. Never commit a real `.env`.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000
# Comma-separated CORS allowlist (exact origins).
WEB_ORIGINS=http://localhost:3000
# Set to true only behind a trusted reverse proxy / load balancer.
TRUST_PROXY=false

# --- Data stores (see infra/compose/docker-compose.yml) ---
DATABASE_URL=postgres://anvaya:anvaya_local_only@127.0.0.1:5433/anvaya
DATABASE_POOL_MAX=10
REDIS_URL=redis://127.0.0.1:6379/0

# --- Sessions ---
SESSION_TTL_HOURS=168
# Must be true in production (enforced). false only for plain-http localhost.
COOKIE_SECURE=false
# Development-only email sign-in. Refused at boot when NODE_ENV=production.
AUTH_DEV_LOGIN_ENABLED=true

# --- GitHub App (https://docs.github.com/apps) ---
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Prefer a file path (or a secret manager) over an inline key.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string
# OAuth credentials of the same GitHub App, used for user sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AI service (services/ai-service) ---
AI_SERVICE_URL=http://127.0.0.1:8001
# Shared secret for API -> AI service calls; required in production.
AI_SERVICE_TOKEN=replace-with-a-long-random-string
AI_REQUEST_TIMEOUT_MS=120000
EMBEDDING_DIMENSION=768

# --- Storage / repository source ---
STORAGE_DIR=./storage
# github | local_fixture (local_fixture is for development/tests only)
REPOSITORY_SOURCE=github
LOCAL_FIXTURE_ROOT=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX=300

# --- Execution plane (sandboxed verification) ---
# disabled: approved runs fail explicitly with EXECUTION_NOT_AVAILABLE.
# docker:   hardened containers for DEVELOPMENT (refused in production: SECURITY §7
#           requires a microVM / dedicated sandbox service for untrusted code).
EXECUTION_DRIVER=disabled
WORKSPACES_DIR=./workspaces
SANDBOX_DOCKER_BIN=docker
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=256
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_OUTPUT_LIMIT_BYTES=1000000

# --- Observability ---
# Set to enable GET /api/v1/internal/metrics (Authorization: Bearer <token>).
METRICS_TOKEN=
# Worker metrics on 127.0.0.1:<port>/metrics (unset = disabled).
WORKER_METRICS_PORT=

# --- Tracing (OpenTelemetry) ---
# Off by default. "otlp" exports to OTEL_EXPORTER_OTLP_ENDPOINT (HTTP, e.g. http://localhost:4318);
# "console" prints spans (development). Log lines carry trace_id/span_id when a span is active.
# OTEL_TRACES_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER_ARG=1
