# ── Anvaya web (apps/web) ────────────────────────────────────────────────
# No secrets belong here. Everything prefixed NEXT_PUBLIC_ is inlined into the
# browser bundle at build time.

# Data source for the UI:
#   fixtures → in-browser development fixtures (no backend required)
#   http     → real NestJS control plane via same-origin /api/v1
NEXT_PUBLIC_API_MODE=fixtures

# Server-only. Origin of the NestJS API that /api/v1/* is rewritten to in http mode.
# ANVAYA_API_ORIGIN=http://localhost:4000

# Public slug of the GitHub App, used to build the installation URL
# (https://github.com/apps/<slug>/installations/new). Not a secret.
NEXT_PUBLIC_GITHUB_APP_SLUG=anvaya-dev
