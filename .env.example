# Anvaya — environment overview. Every value here is a safe placeholder; never commit a real .env.
#
# Each service reads its own file (copy the example next to it to .env):
#   apps/api/.env.example             API + worker (database, Redis, GitHub App, AI service, sandbox)
#   services/ai-service/.env.example  AI service (Ollama, embeddings, optional hosted provider)
#   apps/web/.env.example             Web (fixtures vs http mode, API origin for the /api/v1 proxy)
#
# This root file holds only the variables the compose stacks and deploy scripts read.

# --- Development stack (infra/compose/docker-compose.yml) ---
# Embeddings for the containerised AI service: mock (no model) or ollama.
ANVAYA_EMBEDDING_PROVIDER=mock
# Ollama endpoint seen from containers (Ollama on the host or in WSL).
ANVAYA_OLLAMA_URL=http://host.docker.internal:11434

# --- Production-like stack (infra/compose/docker-compose.prod.yml, scripts/deploy) ---
# Image tag to deploy; scripts/deploy/build-images.sh prints it (the commit SHA).
ANVAYA_TAG=
ANVAYA_PROD_DB_PASSWORD=change-me-prod-local-db-password
ANVAYA_PROD_AI_TOKEN=change-me-prod-local-ai-service-token
# Where deploy.sh smoke-tests the web origin, and how long it waits for health.
ANVAYA_WEB_URL=http://127.0.0.1:3080
ANVAYA_DEPLOY_TIMEOUT=180

# --- Opt-in live tests (never required by CI) ---
# Real gVisor probes: test/gvisor.live.spec.ts (see .github/workflows/backend-ci.yml for the setup).
ANVAYA_TEST_RUNSC=0
