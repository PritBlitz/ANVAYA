# Anvaya AI service — example configuration. Copy to `.env`. Placeholders only.
NODE_ENV=development
LOG_LEVEL=INFO

# Must equal AI_SERVICE_TOKEN in apps/api/.env. Required in production.
AI_SERVICE_TOKEN=replace-with-a-long-random-string

# Local inference (default). Install: `ollama pull qwen2.5-coder:7b && ollama pull nomic-embed-text`
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GENERATION_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# CPU-only hardware: start with one concurrent request and a 4K context; benchmark before raising.
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_TIMEOUT_SECONDS=300

# ollama | mock  (mock = deterministic vectors for tests/dev without Ollama)
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSION=768

# Hosted (cloud) inference is OFF unless HOSTED_PROVIDER lists adapters:
# "anthropic", "openai_compatible", or both comma-separated. An adapter is used only
# for workspaces whose AI policy selects it with an acknowledged data disclosure;
# failures and refusals are errors, never a fallback to another provider or model.
HOSTED_PROVIDER=none
# ANTHROPIC_API_KEY=            # required for anthropic (use a secret manager in production)
# HOSTED_MODEL=claude-opus-5-5  # must match the workspace policy's cloud.model
# HOSTED_EFFORT=medium          # low | medium | high | xhigh | max
# OpenAI-compatible chat completions (OpenAI, or a self-hosted vLLM / llama.cpp / LiteLLM server):
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API_KEY=        # optional for self-hosted servers; never commit a real key
# OPENAI_COMPAT_MODEL=          # must match the workspace policy's cloud.model
# OPENAI_COMPAT_RESPONSE_FORMAT=json_schema   # json_schema | json_object | none
# OPENAI_COMPAT_MAX_TOKENS_PARAM=max_tokens   # or max_completion_tokens
# OPENAI_COMPAT_PRICE_INPUT_PER_MTOK=         # optional, for the advisory cost estimate
# OPENAI_COMPAT_PRICE_OUTPUT_PER_MTOK=
# OPENAI_COMPAT_ALLOW_HTTP=false              # http is refused in production unless true
MAX_EVIDENCE_ITEMS=24
